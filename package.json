{
  "name": "optothermal-simulator",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build:wasm": "node scripts/build-rust-wasm.mjs",
    "predev": "pnpm build:wasm",
    "dev": "vite",
    "build": "pnpm build:wasm && tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "pnpm build:wasm && vitest run",
    "test:ui": "playwright test",
    "check:conformance": "node node_modules/@jorpago2/scientific-ui/scripts/check-conformance.mjs src"
  },
  "dependencies": {
    "@carbon/react": "1.113.0",
    "@ibm/plex": "6.4.1",
    "@jorpago2/scientific-ui": "file:vendor/jorpago2-scientific-ui-0.14.7.tgz",
    "plotly.js-cartesian-dist-min": "3.7.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@types/node": "24.10.13",
    "@types/plotly.js": "3.0.10",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.0.5",
    "esbuild": "0.27.3",
    "sass": "1.102.0",
    "typescript": "6.0.2",
    "vite": "8.2.0",
    "vitest": "4.1.10"
  }
}
